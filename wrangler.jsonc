
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "renace-ia-zona20",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": false
  },
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "RENACE_SEARCH",
      "instance_name": "renace-fuentes-zona20"
    }
  ],
  "upload_source_maps": true
}
